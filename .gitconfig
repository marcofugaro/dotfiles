[user]
  name = Marco Fugaro
  email = marco.fugaro@gmail.com

[core]
  # set global gitignore
  excludesfile = ~/.gitignore
  # set standard editor
  editor = vim
  # diff-so-fancy as pager
  pager = diff-so-fancy | less --tabs=4 -RFX
  # ignore case changes in file names
  ignorecase = true
[alias]
  # compact graph log
  superlog = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'

  # make `git git` work
  git = !exec git

  # list tags, branches and remotes
  tags = tag -l
  branches = branch -a
  remotes = remote -v

  # undo the last commit, keeping its changes staged
  undo = reset --soft HEAD^

  # undo the last push
  undo-push = !git push -f origin HEAD^:$(git symbolic-ref HEAD)

  # delete local branches merged into the current one
  purge = !git branch --merged HEAD | grep -vE 'master|main|develop|dev' | xargs -n 1 git branch -d

  # delete local branches squash-merged into the current one
  # https://github.com/not-an-aardvark/git-delete-squashed
  purge-squashed = "!f() { git for-each-ref refs/heads/ '--format=%(refname:short)' | grep -vE 'master|main|develop|dev' | while read branch; do mergeBase=$(git merge-base HEAD $branch) && [[ $(git cherry HEAD $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == '-'* ]] && git branch -D $branch; done; }; f"


  # stash untracked files too
  stashall = stash --include-untracked

[push]
  # push only the current branch
  default = current

  # push annotated tags along with commits
  followTags = true

  # set the upstream on the first push
  autoSetupRemote = true

[pull]
  # rebase instead of merging on pull
  rebase = true

[fetch]
  # remove remote-tracking branches deleted on the remote
  prune = true

[help]
  # run the corrected command on typos
  autocorrect = -1

[rerere]
  # reuse recorded conflict resolutions
  enabled = 1
  autoupdate = 1

[web]
  # open links in Chrome
  browser = google-chrome
